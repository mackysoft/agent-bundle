{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["suiteId", "suiteVersion", "schemaVersion", "digestMethod", "canonicalSuiteDigest", "cases"],
  "additionalProperties": false,
  "properties": {
    "suiteId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "suiteVersion": {"type": "string", "minLength": 1},
    "schemaVersion": {"const": "1.0"},
    "digestMethod": {"const": "sha256-canonical-suite-v1"},
    "canonicalSuiteDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "cases": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["caseId", "split", "taskFamily", "group"], "additionalProperties": false, "properties": {"caseId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "split": {"enum": ["pilot", "development", "validation", "sealed"]}, "taskFamily": {"type": "string", "minLength": 1}, "group": {"type": "string", "minLength": 1}}}}
  }
}
